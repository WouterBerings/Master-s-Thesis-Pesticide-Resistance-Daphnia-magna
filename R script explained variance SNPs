library(glmmTMB)
library(dplyr)

D=read.csv('D1.csv')
getwd()
str(D)
df <- D |> dplyr::mutate(across(where(is.character), as.factor))
df <- df %>% mutate(obs_id = factor(row_number()))


model_bb <- glmmTMB(cbind(alive, dead) ~ treatment * pond_code +
                      (1 | clone_code) + (1 | date) + (1 | observer) + (1 | obs_id),
                    family = binomial(link = "logit"), data = df)
blups <- ranef(model_bb)$cond$clone_code


# 1. Check overdispersion — obs_id as OLRE is good, confirm it's absorbing it
summary(model_bb)

# Extract variance components
vc <- VarCorr(model_bb)
print(vc)

