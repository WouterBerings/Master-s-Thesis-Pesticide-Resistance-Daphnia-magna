library(data.table)
library(glmmTMB)
library(dplyr)

# ── Variance components from your BLUP model ──────────────────────────────────
vc       <- VarCorr(model_bb)$cond
V_clone  <- as.numeric(vc$clone_code)
V_date   <- as.numeric(vc$date)
V_obs    <- as.numeric(vc$observer)
V_olre   <- as.numeric(vc$obs_id)
V_binom  <- pi^2 / 3

V_P_latent <- V_clone + V_date + V_obs + V_olre + V_binom

# ── Load GWAS results ─────────────────────────────────────────────────────────
gwas <- fread("results.assoc.txt")

# ── Filter and compute variance explained ─────────────────────────────────────
gwas <- gwas %>%
  filter(n_miss == 0) %>%                          # complete SNPs only
  mutate(
    MAF   = ifelse(af > 0.5, 1 - af, af),
    V_SNP = 2 * beta^2 * MAF * (1 - MAF),
    r2_Vg = V_SNP / V_clone,                       # % of clonal/genetic variance
    r2_Vp = V_SNP / V_P_latent                     # % of total latent variance
  )

# ── Top hits ──────────────────────────────────────────────────────────────────
gwas %>%
  filter(MAF >= 0.05) %>%                          # exclude rare variants
  arrange(p_wald) %>%
  select(chr, ps, allele1, allele0, MAF, beta, se, p_wald, V_SNP, r2_Vg, r2_Vp) %>%
  head(20)

