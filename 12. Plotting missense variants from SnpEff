# ------------------------------------------------------------
# 1. Read allele-frequency tables
# ------------------------------------------------------------
read_af <- function(file, group) {
  df <- read.table(file, header = FALSE,
                   col.names = c("CHROM","POS","REF","ALT","AF","AC","AN"))
  df$group <- group
  df
}

res <- read_af("af_all_missense_resistant.txt",    "resistant")
het <- read_af("af_all_missense_heterozygous.txt", "heterozygous")
sus <- read_af("af_all_missense_susceptible.txt",  "susceptible")

# ------------------------------------------------------------
# 2. Missense positions from SnpEff
