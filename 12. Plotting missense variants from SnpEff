residues_to_genomic_ranges <- function(genomic_positions, width = 3) {
  positions <- sort(unique(genomic_positions))
  starts <- c(); ends <- c()
  i <- 1
  while (i <= length(positions)) {
    s <- positions[i]; e <- positions[i]
    while (i < length(positions) && positions[i+1] <= positions[i] + 10) {
      i <- i + 1; e <- positions[i]
    }
    starts <- c(starts, s)
    ends   <- c(ends, e + width)
    i <- i + 1
  }
  return(data.frame(xmin = starts, xmax = ends))
}

