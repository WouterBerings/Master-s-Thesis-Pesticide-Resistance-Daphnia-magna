                  1204676, 1204895, 1205077, 1205255, 1205416,
                  1205628, 1205790, 1205889, 1206216, 1206239)

res <- res[res$POS %in% missense_pos, ]
het <- het[het$POS %in% missense_pos, ]
sus <- sus[sus$POS %in% missense_pos, ]

# ------------------------------------------------------------
# 3. Merge resistant vs susceptible for Fisher's test,
#    and also bring in heterozygous AF for plotting
# ------------------------------------------------------------
merged <- merge(
  res[, c("POS","REF","ALT","AF","AC","AN")],
  sus[, c("POS","AF","AC","AN")],
  by = "POS", suffixes = c("_res","_sus")
)

# Add heterozygous AF (for Plot 2)
merged <- merge(
  merged,
  het[, c("POS","AF")],
  by = "POS", all.x = TRUE
)
names(merged)[names(merged) == "AF"] <- "AF_het"

# ------------------------------------------------------------
# 4. Fisher's exact test: resistant vs susceptible
# ------------------------------------------------------------
fisher_results <- lapply(1:nrow(merged), function(i) {
  row <- merged[i, ]
  mat <- matrix(c(
    round(row$AC_res),
    round(row$AN_res - row$AC_res),
    round(row$AC_sus),
    round(row$AN_sus - row$AC_sus)
  ), nrow = 2)
  ft <- fisher.test(mat)
  data.frame(
    POS        = row$POS,
    REF        = row$REF,
    ALT        = row$ALT,
    AF_res     = row$AF_res,
    AF_sus     = row$AF_sus,
    AF_het     = row$AF_het,
    diff       = row$AF_res - row$AF_sus,
    p_fisher   = ft$p.value,
    odds_ratio = ft$estimate
  )
})

fisher_df <- do.call(rbind, fisher_results)

# Bonferroni correction (30 tests)
fisher_df$p_bonferroni <- fisher_df$p_fisher * 30
fisher_df$significant  <- fisher_df$p_bonferroni < 0.05

