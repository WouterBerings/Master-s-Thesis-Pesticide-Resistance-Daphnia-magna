# 13. merged_box — genotype × BLUP data for Plot 3
# ------------------------------------------------------------

# Read phenotype (BLUP) file
pheno <- read.table("new.txt", header = TRUE,
                    col.names = c("FID","IID","BLUP"))

# Read genotype classes file (no header, two columns: IID and class)
geno <- read.table("genotype_classes.txt", header = FALSE,
                   col.names = c("IID","geno_raw"))

# Recode genotype labels to match plot
geno$Genotype <- dplyr::recode(geno$geno_raw,
                               "GG_susceptible"  = "G/G",
                               "GA_heterozygous" = "G/A",
                               "AA_resistant"    = "A/A"
)

# Merge on IID
merged_box <- merge(pheno[, c("IID","BLUP")],
                    geno[, c("IID","Genotype")],
                    by = "IID")

# Enforce factor order for plotting
merged_box$Genotype <- factor(merged_box$Genotype,
                              levels = c("G/G","G/A","A/A"))

# ------------------------------------------------------------
# 14. Pairwise Wilcoxon test (Plot 3 significance brackets)
# ------------------------------------------------------------
pwc <- pairwise.wilcox.test(merged_box$BLUP,
                            merged_box$Genotype,
                            p.adjust.method = "bonferroni")
print(pwc)

# Convert to ggpubr-compatible format for stat_pvalue_manual
pwc_tidy <- as.data.frame(as.table(pwc$p.value))
pwc_tidy <- pwc_tidy[!is.na(pwc_tidy$Freq), ]
names(pwc_tidy) <- c("group1","group2","p.adj")
pwc_tidy$p.adj.signif <- ifelse(pwc_tidy$p.adj < 0.001, "***",
                                ifelse(pwc_tidy$p.adj < 0.01,  "**",
                                       ifelse(pwc_tidy$p.adj < 0.05,  "*",  "ns")))
# y-position for brackets (adjust if your BLUP range differs)
pwc_tidy$y.position <- max(merged_box$BLUP, na.rm = TRUE) *
  c(1.05, 1.12, 1.19)[seq_len(nrow(pwc_tidy))]

