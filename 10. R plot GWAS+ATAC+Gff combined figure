has_ggrepel <- requireNamespace("ggrepel", quietly = TRUE)

ATAC_OPEN  <- "#7DBF8E"   # matte light green
ATAC_CLOSE <- "#D3D3D3"   # light grey (matches exon fill)

PAL <- list(
  chr_a    = "blue4",
  chr_b    = "orange3",
  sig_pt   = "#c0392b",
  top_hit  = "#c0392b",
  sig_line = "#c0392b",
  sug_line = "#1a6bb5",
  gene     = "#2c2c2c",
  exon     = "lightgrey",
  bg       = "white"
)

GWAS_CHROM       <- "scaffold_5"
GFF_CHROM        <- "CM058177.1"
chrom_label     <- function(x) sub("scaffold_", "", x, ignore.case=TRUE)
normalise_chrom <- function(x) ifelse(x == GFF_CHROM, GWAS_CHROM, x)

# =============================================================================
# LOADERS
# =============================================================================

load_gwas <- function(path) {
  dt  <- fread(path)
  cn  <- colnames(dt)
  chr_col <- cn[grep("^(chr|chrom|scaffold|contig)", cn, ignore.case=TRUE)][1]
  bp_col  <- cn[grep("^(ps|bp|pos|position)",        cn, ignore.case=TRUE)][1]
  p_col   <- cn[grep("^(p_wald|p_lrt|p$|pval)",     cn, ignore.case=TRUE)][1]
  message(sprintf("  GWAS columns: CHR='%s'  BP='%s'  P='%s'",
                  chr_col, bp_col, p_col))
  out <- dt[, .(CHR=as.character(get(chr_col)),
                BP =as.integer(get(bp_col)),
                P  =as.numeric(get(p_col)))]
  out[, NEGLOGP := -log10(pmax(P, 1e-300))]
  out <- out[!is.na(P) & P > 0 & P <= 1]
  rm(dt); gc()
  out
}

load_gff <- function(path) {
  lines  <- readLines(path)
  lines  <- lines[!grepl("^#", lines) & nzchar(trimws(lines))]
  fields <- strsplit(lines, "\t")
  fields <- fields[lengths(fields) >= 8]
  df <- as.data.frame(do.call(rbind, lapply(fields, function(x) x[1:9])),
                      stringsAsFactors=FALSE)
  names(df) <- c("seqname","source","feature","start","end",
                 "score","strand","frame","attributes")
  df$start   <- as.integer(df$start)
  df$end     <- as.integer(df$end)
  df$seqname <- normalise_chrom(df$seqname)
  df$name <- mapply(function(attr, feat) {
    m <- regmatches(attr, regexpr("(?i)Name=([^;]+)", attr, perl=TRUE))
    if (length(m) && nzchar(m)) return(sub("(?i)Name=","",m,perl=TRUE))
    m2 <- regmatches(attr, regexpr('gene_id "([^"]+)"', attr, perl=TRUE))
    if (length(m2) && nzchar(m2))
      return(sub('gene_id "([^"]+)".*',"\\1",m2,perl=TRUE))
    m3 <- regmatches(attr, regexpr("(?i)ID=([^;]+)", attr, perl=TRUE))
    if (length(m3) && nzchar(m3)) return(sub("(?i)ID=","",m3,perl=TRUE))
    feat
  }, df$attributes, df$feature, SIMPLIFY=TRUE)
  df
}

load_bed <- function(path) {
  dt <- fread(path, header=FALSE, sep="\t", fill=TRUE)
  setnames(dt, 1:3, c("chrom","start","end"))
  dt[, chrom := normalise_chrom(as.character(chrom))]
  dt[, score := if (ncol(dt) >= 4) as.numeric(dt[[4]]) else 1]
  dt[is.na(score), score := 0]
  dt
}

# =============================================================================
# SHARED X SCALE
# =============================================================================
zoom_x_scale <- function(start, end) {
  scale_x_continuous(
    limits = c(start, end),
    labels = function(x) formatC(x, format="d", big.mark=","),
    expand = expansion(mult=c(0.01, 0.01))
  )
}

# =============================================================================
# HELPER: fraction of gtable total width at left/right edge of panel cell
# =============================================================================
gt_panel_fracs <- function(gt) {
  pcol  <- gt$layout$l[gt$layout$name == "panel"][1]
  ws    <- as.numeric(gt$widths)
  total <- sum(ws)
  c(left  = sum(ws[seq_len(pcol - 1)]) / total,
    right = sum(ws[seq_len(pcol)])      / total)
}

