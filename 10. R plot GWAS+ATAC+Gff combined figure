GWAS_PATH  <- "results.assoc.txt"
zoom_start <- 1190000
zoom_end   <- 1215000
chrom      <- GWAS_CHROM

message("Loading data ...")
gwas <- load_gwas(GWAS_PATH)
gff  <- load_gff("annotation.gff")
atac <- load_bed("atacseq.bed")

# Pre-compute significant SNP positions in the zoom window (shared by B/C/D)
sig_threshold <- 5e-8
sig_positions <- gwas[CHR == chrom &
                        BP  >= zoom_start &
                        BP  <= zoom_end   &
                        P   <  sig_threshold, unique(BP)]
message(sprintf("  Found %d significant SNP(s) in zoom window.", length(sig_positions)))

message("Building Manhattan ...")
man <- build_manhattan_full(gwas, chrom)
rm(gwas); gc()

message("Building zoom panel ...")
p_zoom <- build_zoom(GWAS_PATH, chrom, zoom_start, zoom_end)

message("Building gene panel ...")
p_gene <- build_genes(gff, chrom, zoom_start, zoom_end, sig_bp=sig_positions)

message("Building ATAC panel ...")
p_atac <- build_atac(atac, chrom, zoom_start, zoom_end, sig_bp=sig_positions)

message("Composing figure ...")
compose_figure(man, p_zoom, p_gene, p_atac, out_path="genome_browser.png")
